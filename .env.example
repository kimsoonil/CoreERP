# Local isolated demo only. Generate different long random values before running.
POSTGRES_PASSWORD=replace-with-random-database-password
APP_ADMIN_PASSWORD=replace-with-random-admin-password
APP_DEMO_PASSWORD=replace-with-random-demo-role-password
APP_PROFILE=demo
WEB_PORT=8088
COOKIE_SECURE=false

# Optional KST daily scheduler, default off. Manual ADMIN batch remains available.
DAILY_BATCH_ENABLED=false
DAILY_BATCH_CRON=0 10 2 * * *
